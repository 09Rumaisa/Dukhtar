# OpenAI API Key (required for AI features)
OPENAI_API_KEY=your_openai_api_key_here

# Tavily API Key (required for pregnancy guide search)
TAVILY_API_KEY=your_tavily_api_key_here

# LangSmith API Key (optional - for monitoring)
LANGSMITH_API_KEY=your_langsmith_api_key_here

# AWS S3 Configuration (required for file storage)
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=us-east-1
AWS_S3_IMAGES_BUCKET=your-images-bucket-name
AWS_S3_AUDIO_BUCKET=your-audio-bucket-name

# PostgreSQL Database Configuration (Local Development)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=Dukhtar
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Production Database URL (set by hosting platform like Render/Railway)
# For local development, use format: postgresql://user:password@host:port/database
# DATABASE_URL=postgresql://postgres:password@localhost:5432/Dukhtar

# Flask Configuration (for production)
# FLASK_ENV=production
# FLASK_SECRET_KEY=generate_with_python_secrets_module